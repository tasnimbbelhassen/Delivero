<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion - DELIVERO</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    
    <style>
    :root {
    --primary-green: #39C1C1;
    --dark-green: #216767;
    --bg-light: #FBFCF8;
    --card-bg: #FFFFFF;
    --text-dark: #216767;
    --text-gray: #888888;
    --border-color: #E0E0E0;
    --shadow-light: 0 4px 20px rgba(0, 0, 0, 0.05);
    --shadow-medium: 0 8px 30px rgba(0, 0, 0, 0.08);
    --success-color: #28a745;
    --warning-color: #ffc107;
    --danger-color: #dc3545;
    --info-color: #17a2b8;
}

* {
    box-sizing: border-box;
}

body {
    background: var(--bg-light);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    position: relative;
    padding: 20px;
    overflow-x: hidden;
}


body::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: 
        radial-gradient(circle at 20% 50%, rgba(57, 193, 193, 0.15) 0%, transparent 50%),
        radial-gradient(circle at 80% 80%, rgba(33, 103, 103, 0.15) 0%, transparent 50%);
    z-index: 0;
    animation: backgroundPulse 8s ease-in-out infinite;
}

@keyframes backgroundPulse {
    0%, 100% { opacity: 0.7; }
    50% { opacity: 1; }
}

.login-container {
    background: var(--card-bg);
    border-radius: 24px;
    box-shadow: var(--shadow-medium);
    width: 100%;
    max-width: 440px;
    overflow: hidden;
    position: relative;
    z-index: 1;
    border: 1px solid var(--border-color);
    animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes slideUp {
    from {
        opacity: 0;
        transform: translateY(40px) scale(0.95);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.login-header {
    text-align: center;
    padding: 45px 30px;
    background: linear-gradient(135deg, var(--primary-green) 0%, var(--dark-green) 100%);
    color: white;
    position: relative;
    overflow: hidden;
}

.login-header::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, transparent 70%);
    animation: headerPulse 4s ease-in-out infinite;
}

@keyframes headerPulse {
    0%, 100% { 
        transform: scale(1) translate(0, 0); 
        opacity: 0.5; 
    }
    50% { 
        transform: scale(1.1) translate(-10px, -10px); 
        opacity: 0.8; 
    }
}

.login-header i {
    font-size: 4rem;
    margin-bottom: 15px;
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.3));
    animation: iconFloat 3s ease-in-out infinite;
    display: inline-block;
}

@keyframes iconFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
}

.login-header h1 {
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
    position: relative;
    z-index: 1;
    letter-spacing: 1px;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
}

.login-body {
    padding: 40px 35px;
}

.form-label {
    font-weight: 600;
    color: var(--text-dark);
    margin-bottom: 10px;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
}

.form-label i {
    font-size: 1.1rem;
    color: var(--primary-green);
    transition: all 0.3s ease;
}

.form-control {
    padding: 15px 18px;
    border-radius: 12px;
    border: 2px solid var(--border-color);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    background: var(--bg-light);
    color: var(--text-dark);
    font-size: 0.95rem;
    width: 100%;
}

.form-control:focus {
    border-color: var(--primary-green);
    box-shadow: 0 0 0 5px rgba(57, 193, 193, 0.12);
    background: var(--card-bg);
    outline: none;
    transform: translateY(-2px);
}

.form-control::placeholder {
    color: var(--text-gray);
    opacity: 0.7;
}

.input-group {
    position: relative;
    display: flex;
    align-items: center;
}

.input-group .form-control {
    flex: 1;
    border-radius: 12px;
}

.input-group .btn-outline-secondary {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    border: none;
    background: transparent;
    color: var(--text-gray);
    padding: 8px 12px;
    border-radius: 8px;
    transition: all 0.3s ease;
    z-index: 10;
}

.input-group .btn-outline-secondary:hover {
    background: rgba(57, 193, 193, 0.1);
    color: var(--primary-green);
}

.input-group .btn-outline-secondary:focus {
    box-shadow: none;
    outline: none;
}

.input-group .btn-outline-secondary i {
    font-size: 1.2rem;
}

.btn-login {
    background: linear-gradient(135deg, var(--primary-green) 0%, var(--dark-green) 100%);
    border: none;
    color: white;
    padding: 16px;
    border-radius: 12px;
    font-weight: 600;
    font-size: 1.05rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 20px rgba(57, 193, 193, 0.35);
    position: relative;
    overflow: hidden;
    width: 100%;
}

.btn-login::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
    transform: translateX(-100%);
    transition: transform 0.6s;
}

.btn-login:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(57, 193, 193, 0.45);
    color: white;
}

.btn-login:hover::before {
    transform: translateX(100%);
}

.btn-login:active {
    transform: translateY(-1px);
    box-shadow: 0 4px 15px rgba(57, 193, 193, 0.4);
}

.btn-login:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
}

.btn-login:disabled:hover {
    transform: none;
    box-shadow: 0 4px 20px rgba(57, 193, 193, 0.35);
}

.btn-login i {
    margin-right: 8px;
}

.alert {
    border-radius: 12px;
    border: none;
    padding: 14px 18px;
    font-size: 0.9rem;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    animation: alertSlide 0.4s ease-out;
    margin-bottom: 20px;
}

@keyframes alertSlide {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.alert-danger {
    background: linear-gradient(135deg, #ffe5e5 0%, #ffd4d4 100%);
    color: var(--danger-color);
    border-left: 4px solid var(--danger-color);
}

.alert-success {
    background: linear-gradient(135deg, #d4f4dd 0%, #c3f0d0 100%);
    color: var(--success-color);
    border-left: 4px solid var(--success-color);
}

.alert .btn-close {
    margin-left: auto;
}


.text-center a,
.forgot-password,
.forgot-password-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--primary-green);
