}

.text-center a small,
.forgot-password small,
.forgot-password-link small {
    position: relative;
    z-index: 1;
}


.forgot-password-link.with-icon::after {
    content: '\F138';
    font-family: 'bootstrap-icons';
    font-size: 0.85rem;
    transition: transform 0.3s ease;
    position: relative;
    z-index: 1;
}

.forgot-password-link.with-icon:hover::after {
    transform: translateX(3px);
}

.login-footer {
    text-align: center;
    padding: 25px;
    background: linear-gradient(180deg, var(--bg-light) 0%, #f0f2ed 100%);
    border-top: 1px solid var(--border-color);
