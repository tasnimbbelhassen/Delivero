<script>
document.addEventListener('DOMContentLoaded', function() {
    
    const nameInput = document.getElementById('name');
    const priceInput = document.getElementById('price');
    const descriptionInput = document.getElementById('description');
    const ingredientsInput = document.getElementById('ingredients');
    const preparationTimeInput = document.getElementById('preparation_time');
    const categorySelect = document.getElementById('category_id');
    const restaurantSelect = document.getElementById('restaurant_id');
    const imageInput = document.getElementById('image');
    const isAvailableCheckbox = document.getElementById('is_available');
    const isSpecialCheckbox = document.getElementById('is_special');
    const isVegetarianCheckbox = document.getElementById('is_vegetarian');
    
    
    const previewName = document.getElementById('previewName');
    const previewPrice = document.getElementById('previewPrice');
    const previewDescription = document.getElementById('previewDescription');
    const previewIngredients = document.getElementById('previewIngredients');
    const previewTime = document.getElementById('previewTime');
    const previewCategory = document.getElementById('previewCategory');
    const previewRestaurant = document.getElementById('previewRestaurant');
    const imagePreview = document.getElementById('imagePreview');
    const availabilityBadge = document.getElementById('availabilityBadge');
    const specialBadge = document.getElementById('specialBadge');
    const vegetarianBadge = document.getElementById('vegetarianBadge');
    
    
    function updatePreview() {
        
        previewName.textContent = nameInput.value || 'Nom du plat';
        
       
        const price = parseFloat(priceInput.value) || 0;
        previewPrice.textContent = price.toFixed(2).replace('.', ',') + ' €';
        
        
        previewDescription.textContent = descriptionInput.value || 
            'Description apparaîtra ici...';
        if (previewDescription.textContent.length > 100) {
            previewDescription.textContent = previewDescription.textContent.substring(0, 100) + '...';
        }
        
        
        previewIngredients.textContent = ingredientsInput.value || 
            'Tomate, Mozzarella, Basilic...';
        if (previewIngredients.textContent.length > 80) {
            previewIngredients.textContent = previewIngredients.textContent.substring(0, 80) + '...';
        }
        
       
        previewTime.textContent = (preparationTimeInput.value || '20') + ' min';
        
        
        const selectedCategory = categorySelect.options[categorySelect.selectedIndex];
        previewCategory.textContent = selectedCategory.text || 'Catégorie';
        
        
        const selectedRestaurant = restaurantSelect.options[restaurantSelect.selectedIndex];
        previewRestaurant.textContent = selectedRestaurant.text || 'Restaurant';
        
        
        if (isAvailableCheckbox.checked) {
            availabilityBadge.style.display = 'inline-block';
            availabilityBadge.className = 'badge bg-success me-1';
            availabilityBadge.innerHTML = '<i class="bi bi-check-circle"></i> Disponible';
        } else {
            availabilityBadge.style.display = 'inline-block';
            availabilityBadge.className = 'badge bg-danger me-1';
            availabilityBadge.innerHTML = '<i class="bi bi-x-circle"></i> Indisponible';
        }
        
        if (isSpecialCheckbox.checked) {
            specialBadge.style.display = 'inline-block';
        } else {
            specialBadge.style.display = 'none';
        }
        
        if (isVegetarianCheckbox.checked) {
            vegetarianBadge.style.display = 'inline-block';
        } else {
            vegetarianBadge.style.display = 'none';
        }
    }
    
   
    nameInput.addEventListener('input', updatePreview);
    priceInput.addEventListener('input', updatePreview);
    descriptionInput.addEventListener('input', updatePreview);
    ingredientsInput.addEventListener('input', updatePreview);
    preparationTimeInput.addEventListener('input', updatePreview);
    categorySelect.addEventListener('change', updatePreview);
    restaurantSelect.addEventListener('change', updatePreview);
    isAvailableCheckbox.addEventListener('change', updatePreview);
    isSpecialCheckbox.addEventListener('change', updatePreview);
    isVegetarianCheckbox.addEventListener('change', updatePreview);
    

    imageInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                imagePreview.innerHTML = `
                    <img src="${e.target.result}" 
                         class="img-fluid rounded" 
                         style="max-height: 200px; object-fit: cover;">
                `;
            };
            reader.readAsDataURL(file);
        }
    });
    
   
    priceInput.addEventListener('blur', function() {
        if (this.value < 0) {
            this.value = 0;
            updatePreview();
        }
    });
    
    
    updatePreview();
    
   
    document.getElementById('dishForm').addEventListener('submit', function(e) {
        const price = parseFloat(priceInput.value);
        if (price <= 0) {
            e.preventDefault();
            alert('Le prix doit être supérieur à 0.');
            priceInput.focus();
            return;
        }
        
        if (!categorySelect.value) {
            e.preventDefault();
            alert('Veuillez sélectionner une catégorie.');
            categorySelect.focus();
            return;
        }
        
        if (!nameInput.value.trim()) {
            e.preventDefault();
            alert('Veuillez saisir un nom pour le plat.');
            nameInput.focus();
            return;
        }
    });
});
</script>

