<script>

document.addEventListener('DOMContentLoaded', function() {
    const nameInput = document.getElementById('name');
    const addressInput = document.getElementById('address');
    const ratingInput = document.getElementById('rating');
    const deliveryTimeInput = document.getElementById('delivery_time');
    const imageInput = document.getElementById('image');
    const imagePreview = document.getElementById('imagePreview');
    
    const previewName = document.getElementById('previewName');
    const previewAddress = document.getElementById('previewAddress');
    const previewRating = document.getElementById('previewRating');
    const previewTime = document.getElementById('previewTime');
    
    function updatePreview() {
        previewName.textContent = nameInput.value || 'Nom du restaurant';
        previewAddress.textContent = addressInput.value || 'Adresse apparaîtra ici...';
        previewRating.textContent = parseFloat(ratingInput.value || 4.0).toFixed(1) + '/5';
        previewTime.textContent = deliveryTimeInput.value || '30-40 min';
    }
    
    nameInput.addEventListener('input', updatePreview);
    addressInput.addEventListener('input', updatePreview);
    ratingInput.addEventListener('input', updatePreview);
    deliveryTimeInput.addEventListener('input', updatePreview);
    
  
    imageInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                imagePreview.innerHTML = `<img src="${e.target.result}" class="img-fluid rounded" style="max-height: 150px; object-fit: cover;">`;
            };
            reader.readAsDataURL(file);
        }
    });
    
    updatePreview();
});
</script>