<script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>
<script>

const qrCodeDiv = document.getElementById('qrcode');
const url = window.location.href;
QRCode.toCanvas(qrCodeDiv, url, { width: 150 }, function(error) {
    if (error) console.error(error);
});


function toggleAvailability(dishId, newStatus) {
    if (confirm(newStatus ? 'Rendre ce plat disponible ?' : 'Rendre ce plat indisponible ?')) {
        fetch(`toggle_availability.php?id=${dishId}&status=${newStatus}`)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Erreur : ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Une erreur est survenue');
            });
    }
}


function toggleSpecial(dishId, newStatus) {
    if (confirm(newStatus ? 'Marquer ce plat comme spécial ?' : 'Retirer le statut spécial ?')) {
        fetch(`toggle_special.php?id=${dishId}&status=${newStatus}`)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Erreur : ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Une erreur est survenue');
            });
    }
}
</script>

