<script>
document.addEventListener('DOMContentLoaded', function() {

    const statusSelect = document.getElementById('status');
    const statusBadge = document.querySelector('.badge.fs-6');
    
    statusSelect.addEventListener('change', function() {
        const status = this.value;
        const statusConfig = {
            'pending': { class: 'warning', icon: 'clock', text: 'En attente' },
            'preparing': { class: 'info', icon: 'egg-fried', text: 'Préparation' },
            'delivering': { class: 'primary', icon: 'truck', text: 'Livraison' },
            'completed': { class: 'success', icon: 'check-circle', text: 'Terminé' },
            'cancelled': { class: 'danger', icon: 'x-circle', text: 'Annulé' }
        };
        
        const config = statusConfig[status];
        if (config && statusBadge) {
            statusBadge.className = `badge bg-${config.class} fs-6`;
            statusBadge.innerHTML = `<i class="bi bi-${config.icon}"></i> ${config.text}`;
        }
    });
    
    
    const totalInput = document.getElementById('total');
    const calculatedTotal = <?= $total_amount ?>;
    
    totalInput.addEventListener('change', function() {
        const enteredTotal = parseFloat(this.value);
        const calculatedTotal = <?= $total_amount ?>;
        
        if (enteredTotal !== calculatedTotal) {
            if (!confirm(`Le montant saisi (${enteredTotal.toFixed(2)} €) diffère du montant calculé (${calculatedTotal.toFixed(2)} €). Continuer ?`)) {
                this.value = calculatedTotal.toFixed(2);
            }
        }
    });
});
</script>